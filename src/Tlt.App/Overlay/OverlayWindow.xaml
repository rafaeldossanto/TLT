<Window x:Class="Tlt.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLT"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="900"
        MinHeight="90">

    <Border CornerRadius="10"
            Padding="18,14"
            MouseLeftButtonDown="AoArrastar">
        <Border.Background>
            <!-- Escuro e translucido: o overlay fica sobre video de conteudo
                 imprevisivel, e legenda que some sobre fundo claro nao serve. -->
            <SolidColorBrush Color="#000000" Opacity="0.78"/>
        </Border.Background>

        <StackPanel>
            <!-- Diagnostico: qual backend esta ativo. A queda para CPU e silenciosa,
                 entao o usuario precisa conseguir ver o que esta rodando. -->
            <TextBlock x:Name="Status"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#7A7A7A"
                       Margin="0,0,0,8"
                       Text="iniciando..."/>

            <!-- Original, menor e apagado: serve de referencia para quem quer
                 conferir o que foi dito, sem competir com a traducao. -->
            <TextBlock x:Name="Original"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="#6E6E6E"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <!-- Traducao: e o que o usuario esta lendo de fato. -->
            <TextBlock x:Name="Confirmado"
                       FontFamily="Segoe UI"
                       FontSize="21"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap"
                       LineHeight="30"/>

            <!-- Hipotese: ainda pode ser revisada, por isso o cinza. Sem essa
                 distincao o leitor ve a frase mudar sozinha e perde a confianca. -->
            <TextBlock x:Name="Provisorio"
                       FontFamily="Segoe UI"
                       FontSize="21"
                       Foreground="#8C8C8C"
                       TextWrapping="Wrap"
                       LineHeight="30"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</Window>
