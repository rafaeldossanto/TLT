<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tlt.Core\Tlt.Core.csproj" />
    <ProjectReference Include="..\Tlt.Audio\Tlt.Audio.csproj" />
    <ProjectReference Include="..\Tlt.Stt.Local\Tlt.Stt.Local.csproj" />
    <ProjectReference Include="..\Tlt.Stt.Cloud\Tlt.Stt.Cloud.csproj" />
    <ProjectReference Include="..\Tlt.Translation\Tlt.Translation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Exigido pelo LibraryImport, o gerador moderno de P/Invoke usado em
         Overlay/NativeMethods.cs. Fica so neste projeto, que e o unico que
         conversa com a API do Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
